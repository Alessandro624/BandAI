# Choose your provider. Available: openrouter, anthropic, openai, ollama
LLM_PROVIDER=openrouter

# Supports OpenAI, Anthropic, Google, Mistral, etc. via a single API key.
OPENROUTER_API_KEY=sk-or-your-key-here

# Anthropic (direct)
# ANHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (direct)
# OPENAI_API_KEY=sk-your-key-here

# Generic fallback (used if provider-specific key is not set)
API_KEY=your_api_key_here

# Provider Base URL (override only for custom/self-hosted endpoints)
# PROVIDER_BASE_URL=https://openrouter.ai/api/v1

# Main Model (reasoning-heavy tasks: compliance analysis, proposal writing)
MAIN_MODEL=anthropic/claude-sonnet-4-20250514
MAIN_TEMPERATURE=0.3
MAIN_MAX_TOKENS=4096

# Fast Model (parallel/scalable tasks: crawling, department bids)
FAST_MODEL=openai/gpt-4o-mini
FAST_TEMPERATURE=0.3
FAST_MAX_TOKENS=4096

# Pipeline Settings
DEFAULT_PORTAL_WEIGHT=0.5
MAX_REVIEW_ITERATIONS=5

# Embedder settings (for knowledge sources and memory)
# EMBEDDER_PROVIDER: provider name (e.g. ollama, openai)
# EMBEDDER_MODEL: model name or provider/model (e.g. mxbai-embed-large or openai/text-embedding-3-large)
# EMBEDDER_BASE_URL: optional base url for embedder provider
# EMBEDDER_API_KEY: optional api key for embedder provider
# Example for Ollama:
# EMBEDDER_PROVIDER=ollama
# EMBEDDER_MODEL=mxbai-embed-large
# EMBEDDER_BASE_URL=http://localhost:11434

# Disable memory (for testing or if you don't want to use it)
# DISABLE_MEMORY=true

# Provider Examples (uncomment and modify to switch)

# Example: Anthropic direct
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# MAIN_MODEL=claude-sonnet-4-20250514
# FAST_MODEL=claude-haiku-3-5-20241022

# Example: OpenAI direct
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# MAIN_MODEL=gpt-4o
# FAST_MODEL=gpt-4o-mini

# Example: Ollama local (no API key needed)
# LLM_PROVIDER=ollama
# PROVIDER_BASE_URL=http://localhost:11434/v1
# MAIN_MODEL=llama3
# FAST_MODEL=llama3
