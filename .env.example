# Provider Base URL
PROVIDER_BASE_URL=https://openrouter.ai/api/v1

# API KEY
API_KEY=your_api_key_here

# Main model parameters: this is the model that will be used for reasoning-heavy tasks.
MAIN_MODEL=openrouter/free
MAIN_TEMPERATURE=0.3
MAIN_MAX_TOKENS=4096

# Fast model parameters: this is the model that will be used for fast tasks.
FAST_MODEL=openrouter/free
FAST_TEMPERATURE=0.3
FAST_MAX_TOKENS=4096

# Default portal weight: used to rank portals
DEFAULT_PORTAL_WEIGHT=0.5

# Maximum number of iterations for the review phase
MAX_REVIEW_ITERATIONS=5
